{
  "name": "izcad",
  "private": true,
  "version": "1.0.0",
  "description": "Offline open-source DXF and DWG viewer for Android",
  "license": "GPL-2.0-only",
  "author": {
    "name": "İZ",
    "email": "tepukmenajeri@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orgofjs/izCAD.git"
  },
  "bugs": {
    "url": "https://github.com/orgofjs/izCAD/issues"
  },
  "homepage": "https://sites.google.com/view/izcad-gp-pp/ana-sayfa",
  "keywords": [
    "android",
    "cad",
    "dxf",
    "dwg",
    "offline",
    "viewer",
    "webassembly"
  ],
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/copy-cad-runtime.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "android:add": "cap add android && node scripts/configure-android.mjs",
    "android:sync": "npm run build && cap sync android && node scripts/configure-android.mjs",
    "android:verify": "node scripts/verify-android.mjs",
    "android:prepare": "npm run android:sync && npm run android:verify"
  },
  "dependencies": {
    "@capacitor/android": "8.4.2",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/core": "8.4.2",
    "@mlightcad/libdxfrw-web": "0.1.0",
    "dxf-viewer": "1.0.48",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "three": "0.161.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.4.2",
    "@types/node": "24.7.0",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "@types/three": "0.161.2",
    "@vitejs/plugin-react": "5.0.4",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "3.2.7"
  }
}
